ADMIN_PASSWORD_HASH=pbkdf2:100000:b374872500d9c9fc6dd42ceaa5449b25:a5dc1e416ffebed57c2e4fe4e9aa0977dfc81b4b1a8b76d12306157a4619ecfe
SESSION_SECRET=dev-only-change-me
# AI evaluation. EVALUATOR=fake is for local dev/tests ONLY (never production); without it a missing ANTHROPIC_API_KEY makes evaluations fail
EVALUATOR=fake
ANTHROPIC_API_KEY=
# Result mail via Resend: both must be set, otherwise the admin copies the link by hand
RESEND_API_KEY=
MAIL_FROM=

# Owner magic-link login: show the link on the page when no mail is configured. LOCAL/E2E ONLY - never set in production
DEV_SHOW_LOGIN_LINK=1
